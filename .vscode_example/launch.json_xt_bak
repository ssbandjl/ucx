{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "uct_hello_world_xt_s",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/examples/.libs/uct_hello_world",
			"args": ["-d", "xtrdma_0:1", "-t", "rc_verbs"],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}/examples/.libs/",
			"environment": [
				{"name": "UCX_LOG_LEVEL", "value": "debug"},
				{"name": "LD_LIBRARY_PATH", "value": "/root/project/rdma/dpu_user_rdma/build/lib"},
				{"name": "HUGE_PAGE_NUM", "value": "20"},
				{"name": "XT_CQ_INLINE_CQE", "value": "0"},
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/bin/gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "uct_hello_world_xt_c",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/examples/.libs/uct_hello_world",
			"args": ["-d", "xtrdma_0:1", "-t", "rc_verbs", "-n", "192.168.2.118"],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}/examples/.libs/",
			"environment": [
				{"name": "UCX_LOG_LEVEL", "value": "debug"},
				{"name": "LD_LIBRARY_PATH", "value": "/root/project/rdma/dpu_user_rdma/build/lib"},
				{"name": "HUGE_PAGE_NUM", "value": "20"},
				{"name": "XT_CQ_INLINE_CQE", "value": "0"},
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/bin/gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "ucp_client_server_xt_s",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/examples/.libs/ucp_client_server",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}/examples/.libs/",
			"environment": [
				{"name": "UCX_LOG_LEVEL", "value": "trace"},
				{"name": "LD_LIBRARY_PATH", "value": "/root/project/rdma/dpu_user_rdma/build/lib"},
				{"name": "HUGE_PAGE_NUM", "value": "20"},
				{"name": "XT_CQ_INLINE_CQE", "value": "0"},
				{"name": "UCX_NET_DEVICES", "value": "xtrdma_0:1"},
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/bin/gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "uct_hello_world_mlx_s",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/examples/.libs/uct_hello_world",
			"args": ["-d", "mlx5_0:1", "-t", "rc_verbs"],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}/examples/.libs/",
			"environment": [
				{"name": "UCX_LOG_LEVEL", "value": "debug"},
				{"name": "LD_LIBRARY_PATH", "value": "/root/project/rdma/rdma-core/build/lib"},
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/bin/gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "ucp_client_server_mlx_s",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/examples/.libs/ucp_client_server",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}/examples/.libs/",
			"environment": [
				{"name": "UCX_LOG_LEVEL", "value": "debug"},
				{"name": "LD_LIBRARY_PATH", "value": "/root/project/rdma/rdma-core/build/lib"},
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/bin/gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "ucx_info_mlx",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/src/tools/info/.libs/ucx_info",
			"args": ["-d"],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}/src/tools/info/.libs/",
			"environment": [
				{"name": "UCX_LOG_LEVEL", "value": "trace"},
				{"name": "LD_LIBRARY_PATH", "value": "/root/project/rdma/dpu_user_rdma/build/lib"},
				{"name": "HUGE_PAGE_NUM", "value": "20"},
				{"name": "XT_CQ_INLINE_CQE", "value": "0"},
				{"name": "UCX_NET_DEVICES", "value": "xtrdma_0:1"},
			],
			"externalConsole": false,
			"MIMode": "gdb",
			"miDebuggerPath": "/bin/gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		},
	]
}